{
  "name": "gamevault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' next dev",
    "dev:clean": "rm -rf .next && NODE_OPTIONS='--max-http-header-size=32768' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--max-http-header-size=32768' next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sab:itemku:collect": "node scripts/collect-itemku-sab.mjs",
    "sab:itemku:send": "node scripts/collect-itemku-sab.mjs --send",
    "sab:eldorado:collect": "node scripts/collect-eldorado-sab-api-v6.mjs",
    "sab:eldorado:send": "node scripts/collect-eldorado-sab-api-v6.mjs --send",
    "sab:eldorado:panel": "node scripts/collect-eldorado-sab-api-v6.mjs --send --refresh-after-hours 20",
    "sab:eldorado:popularity": "node scripts/collect-eldorado-popularity.mjs",
    "sab:price:drift": "tsx scripts/check-sab-price-drift.mjs",
    "sab:g2g:collect": "node scripts/collect-g2g-sab.mjs",
    "sab:g2g:send": "node scripts/collect-g2g-sab.mjs --send",
    "sab:g2g:panel": "node scripts/collect-g2g-sab.mjs --send --refresh-after-hours 20",
    "discord:register": "node scripts/register-discord-commands.mjs",
    "discord:register:global": "node scripts/register-discord-commands.mjs --global",
    "discord:list": "node scripts/register-discord-commands.mjs --list",
    "adoptme:catalog": "node scripts/collect-adoptmevalues.mjs --enrich --send",
    "adoptme:cash:eldorado": "node scripts/collect-eldorado-adoptme.mjs",
    "adoptme:cash:u7buy": "node scripts/collect-u7buy-adoptme.mjs",
    "adoptme:cash:import": "node scripts/import-adoptme-cash.mjs --write",
    "adoptme:cash:refresh": "npm run adoptme:cash:eldorado && npm run adoptme:cash:u7buy && npm run adoptme:cash:import",
    "adoptme:snapshot": "node scripts/adopt-me-snapshot-history.mjs"
  },
  "dependencies": {
