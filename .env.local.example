# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Job Security
CRON_SECRET=your-cron-secret-key-here

# Trustpilot
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=your-business-unit-id
TRUSTPILOT_API_KEY=your-trustpilot-api-key

# Transactional email (Resend) — domain must be verified in the Resend dashboard
RESEND_API_KEY=

# Trustpilot (free plan: Review Collector widget + BCC auto-invitations)
TRUSTPILOT_BCC_EMAIL=

# Discord price-check bot ("DropMarket Values")
# From the Discord Developer Portal → your application.
#   APP_ID / PUBLIC_KEY: General Information
#   BOT_TOKEN:           Bot tab → Reset Token (never commit this)
#   DEV_GUILD_ID:        right-click your server → Copy Server ID (Developer Mode on)
# Only PUBLIC_KEY is needed to SERVE interactions; the token is used solely by
# scripts/register-discord-commands.mjs to register the command set.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=
# Incoming webhook for the daily value-list auto-post (#value-list channel).
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Leave blank to disable the daily post.
DISCORD_VALUE_WEBHOOK_URL=
